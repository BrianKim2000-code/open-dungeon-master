{
  "name": "open-dungeon-master",
  "version": "0.26.3",
  "private": true,
  "description": "Multiplayer D&D 5e campaigns with an AI Dungeon Master, fully on-device",
  "license": "MIT",
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0 -p 3005",
    "build": "next typegen && tsgo --noEmit && next build",
    "typecheck": "next typegen && tsgo --noEmit",
    "start": "next start",
    "start:lan": "next start -H 0.0.0.0 -p 3005",
    "lint": "eslint",
    "audit:check": "node scripts/check-audit.mjs",
    "test": "vitest run",
    "test:browser": "node scripts/browser/run.mjs",
    "coverage": "vitest run --coverage",
    "resources:generate": "node scripts/generate-class-resources.mjs",
    "test:dice": "node scripts/test-dice.mjs",
    "setup": "node scripts/setup.mjs",
    "postinstall": "node scripts/copy-dice-assets.mjs"
  },
  "dependencies": {
    "@3d-dice/dice-box-threejs": "^0.0.12",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/resize": "^2.1.1",
    "@jsquash/webp": "^1.5.0",
    "@modelcontextprotocol/server": "2.3.1",
    "@radix-ui/react-alert-dialog": "^1.1.24",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-tooltip": "^1.3.0",
    "clsx": "^2.1.1",
    "docx": "^9.8.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.52.0",
    "multilingual-stemmer": "2.1.1",
    "next": "16.4.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-easy-crop": "^6.2.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^5.0.3"
  }
}
