# Copy to .env.local (or .env.server) and fill in what you use.
# Everything is optional — the app runs fully local with no keys at all.

# --- Text generation defaults ---
# local = Ollama, custom = "Connect a server" / OpenAI-compatible.
# Unset = the built-in default: custom, llama.cpp on http://127.0.0.1:8001/v1
# serving qwen3.6-35b. Uncomment to override, e.g. to run on Ollama instead.
#DEFAULT_TEXT_PROVIDER=local
#LOCAL_TEXT_MODEL=gemma4:31b-it-qat

# --- Text generation: "Connect a server" provider (all optional) ---
# The Mac launchers can fill these in, or you can enter URL/model in-app.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=
# For OpenRouter URLs:
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.5-flash
# For any other OpenAI-compatible server that needs a key:
OPENAI_COMPAT_API_KEY=
# Max output tokens per remote turn, plus OpenRouter attribution headers:
OPENROUTER_MAX_TOKENS=16384
OPENROUTER_APP_TITLE=Open Dungeon
OPENROUTER_APP_URL=http://localhost:3000

# --- Text generation: local via Ollama (the legacy "local" provider) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_TEXT_MAX_TOKENS=4096
# Context window for local turns. Unset = the model's full native window
# (128K-256K). Set a lower cap to bound prefill time on very long stories.
LOCAL_TEXT_CONTEXT=

# --- Image generation via the OpenAI API (optional, no GPU needed) ---
# Pick "openai" as the image backend (admin panel or the var below) and set
# a key; renders bill to that key. Model blank = gpt-image-1. The base URL
# is only for OpenAI-compatible image proxies.
# Leave the key blank and a story whose Text Model points at api.openai.com
# lends its own key to the pictures, so one key covers text and images.
#DEFAULT_IMAGE_BACKEND=openai
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_BASE_URL=

# --- Image generation (optional, needs ultra-fast-image-gen) ---
FLUX_WORKER_URL=http://127.0.0.1:7869
ULTRA_FAST_IMAGE_GEN_DIR=~/ultra-fast-image-gen
# macOS/Linux: ~/ultra-fast-image-gen/.venv/bin/python
# Windows: %USERPROFILE%\ultra-fast-image-gen\.venv\Scripts\python.exe
ULTRA_FAST_IMAGE_GEN_PYTHON=
IMAGE_SERVER_DEVICE=auto
IMAGE_SERVER_DEFAULT_BACKEND=
# Patched MFLUX checkout (made by ultra-fast-image-gen/scripts/setup_mflux_hs.sh).
# Defaults to ~/.cache/ultra-fast-image-gen/mflux — usually leave unset.
MFLUX_DIR=

# --- Storage ---
SQLITE_DB_PATH=
# Per-account limits on what uploads and imports add to public/uploads in a
# rolling 24 hours (admins are exempt), and the free space the disk must
# keep (0 = no limit):
#UPLOAD_DAILY_BYTES=524288000
#UPLOAD_DAILY_FILES=200
#UPLOAD_MIN_FREE_BYTES=1073741824

# --- Player agent webhooks (optional, off by default) ---
# Wakes a player's connected agent when their character has a decision.
# Exact HTTPS receiver origins, comma-separated. Allow only hosts controlled
# by trusted receiver operators. See docs/player-webhooks.md.
#ODM_PLAYER_WEBHOOK_ORIGINS=https://player-one.example,https://player-two.example

# --- Dev server access from other devices (e.g. phone over Tailscale) ---
# Comma-separated extra hostnames/IPs allowed to reach `next dev`.
ALLOWED_DEV_ORIGINS=
